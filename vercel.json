{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "astro-tarot-web-fe.vercel.app" }
      ],
      "destination": "https://astrotarot.date/:path*",
      "permanent": false
    }
  ]
}
